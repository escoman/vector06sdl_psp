#!/bin/bash

# Release build with the AUTOSELECT_ROM test hook.
#
# Behaves exactly like the plain release (ROM browser and all) UNLESS
# a file named autoselect.txt sits next to the EBOOT in the game dir:
# then the browser is skipped and the ROM with that index (directory
# order of ROMS/) boots directly. Index -1 stays in the 2K boot ROM.
#
# Example: echo 2 > .../VECTOR06C/autoselect.txt  -> boots putup.rom

make DEBUG_ENABLED=0 EXTRA_DEFS=-DAUTOSELECT_ROM
cp /home/alexey/Projects/vector06sdl_psp/psp/boot/EBOOT.PBP /home/alexey/snap/ppsspp-emu/common/.config/ppsspp/PSP/GAME/VECTOR06C/EBOOT.PBP
